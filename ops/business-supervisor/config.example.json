{
  "supervisor_id": "example-supervisor",
  "check_interval_seconds": 60,
  "state_directory": "/app/data",
  "ingestor_health_file": "/observed/ingestor/health.json",
  "startup_grace_seconds": 300,
  "heartbeat_max_age_seconds": 90,
  "mqtt_failure_seconds": 180,
  "target_failure_seconds": 300,
  "queue_warning_seconds": 600,
  "queue_critical_seconds": 1800,
  "repeat_seconds": 3600,
  "recovery_seconds": 180,
  "reminder_seconds_by_category": {},
  "expected_sqlite_temp_directory": "/app/data/sqlite-tmp",
  "sqlite_temp_min_free_fraction": 0.20,
  "devices": [
    {"site_id": "example-site", "gateway_id": "example-gateway", "device_id": "temperature-example", "label": "示例设备", "interval_seconds": 60, "freshness_seconds": 300, "invalid_samples": 3, "require_actual_sample": false, "alerts_enabled": true}
  ],
  "mqtt_client_ids": ["example-ingestor-primary", "example-ingestor-secondary"],
  "targets": ["local", "supabase", "d1"],
  "collector_health_files": [],
  "storage": [
    {"id": "ingestor-data", "path": "/observed/ingestor", "min_free_bytes": 1073741824, "min_free_fraction": 0.10, "min_free_inode_fraction": 0.10},
    {"id": "sqlite-temp", "path": "/observed/sqlite-temp", "min_free_bytes": 0, "min_free_fraction": 0.10, "min_free_inode_fraction": 0.10}
  ],
  "wal": {"warning_bytes": 268435456, "growth_bytes_per_minute": 67108864, "duration_seconds": 300},
  "restart_warning_count": 3,
  "notifications": {
    "enabled": false,
    "webhook_file": "/run/secrets/feishu-webhook",
    "allowed_hosts": ["open.feishu.cn"],
    "timeout_seconds": 5,
    "max_attempts": 10,
    "max_age_seconds": 21600,
    "max_pending": 500,
    "requests_per_hour": 30,
    "requests_per_day": 120
  }
}
