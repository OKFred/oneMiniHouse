#!/bin/sh
set -eu
[ -z "${IPKG_INSTROOT:-}" ] || exit 0
[ "${1:-}" != upgrade ] || exit 0
# Keep an explicit recovery copy including credentials, readable only by root.
backup="/root/collectd-mqtt-ui-backups/remove-$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir -p "$backup"
chmod 700 "$backup"
for f in /etc/config/collectd_mqtt_ui /etc/collectd/conf.d/90-mqtt-ui.conf; do
	[ ! -f "$f" ] || cp -p "$f" "$backup/"
done
/etc/init.d/collectd-mqtt-ui disable
/etc/init.d/collectd-mqtt-ui stop
rm -f /etc/collectd/conf.d/90-mqtt-ui.conf
if /etc/init.d/collectd status >/dev/null 2>&1; then /etc/init.d/collectd restart; fi
echo "MQTT disabled; recovery copy: $backup"
