{
  "schema_version": 1,
  "receiver_id": "example-host-health-receiver",
  "state_directory": "/app/data",
  "mqtt": {
    "url": "mqtts://broker.example.invalid:8883",
    "client_id": "example-host-health-receiver",
    "username": "example-host-health-reader",
    "password_file": "/run/secrets/mqtt-password",
    "keepalive_seconds": 30,
    "session_expiry_seconds": 86400
  },
  "sources": [
    {
      "id": "example-router",
      "site_id": "example-site",
      "host_id": "example-router",
      "topic": "iot/v1/example-site/example-router/host-health",
      "max_age_seconds": 180,
      "max_future_seconds": 30
    }
  ],
  "limits": {
    "max_message_bytes": 16384,
    "max_records": 10000,
    "retention_seconds": 604800,
    "max_database_bytes": 33554432
  }
}
