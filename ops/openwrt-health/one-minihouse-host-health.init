#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1

start_service() {
    [ -s /etc/one-minihouse-host-health/config.json ] || return 1
    [ -s /etc/one-minihouse-host-health/mqtt-password ] || return 1
    /usr/bin/python3 -B /opt/one-minihouse-host-health/agent.py \
        --config /etc/one-minihouse-host-health/config.json --role check || return 1
    for worker in sample publish; do
        procd_open_instance "$worker"
        procd_set_param command /usr/bin/python3 -B /opt/one-minihouse-host-health/agent.py \
            --config /etc/one-minihouse-host-health/config.json --role "$worker"
        procd_set_param respawn 3600 5 5
        procd_set_param term_timeout 10
        procd_set_param stdout 0
        procd_set_param stderr 1
        procd_close_instance
    done
}
