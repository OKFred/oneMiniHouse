{
  "site_id": "example-site",
  "host_id": "example-gateway",
  "state_directory": "/tmp/one-minihouse-host-health",
  "persistent_directory": "/root/.local/share/one-minihouse-host-health",
  "thermal_path": "/sys/class/thermal/thermal_zone0/temp",
  "mounts": {"rootfs": "/", "datafs": "/srv/example-data"},
  "mqtt": {
    "url": "mqtts://mqtt.example.net:8883",
    "client_id": "example-host-health-publisher",
    "username": "example-host-health-writer",
    "password_file": "/etc/one-minihouse-host-health/mqtt-password"
  },
  "mitigation": {
    "enabled": false,
    "proxy": {
      "container_id": "1111111111111111111111111111111111111111111111111111111111111111",
      "image_id": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "compose_project": "example-proxy",
      "compose_service": "proxy",
      "memory_cgroup_path": "/sys/fs/cgroup/memory/docker/1111111111111111111111111111111111111111111111111111111111111111"
    }
  }
}
