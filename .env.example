# Copy to .env.local and configure only public client settings.
# All VITE_* values are visible in the generated app; do not add passwords or tokens.
# Empty defaults keep the app disconnected until you configure your own services.
VITE_API_BASE_URL=
VITE_TCP_HOST=
VITE_TCP_PORT=8899
# Set when hosting H5 below a subpath, for example /one-minihouse/.
VITE_BASE_PATH=/
# WeChat AppID is injected into generated project.config.json only.
UNI_MP_APPID=
# Optional JSON object keyed by electricity, tempHumidity, sound, light or mix.
# Each list contains Modbus hex addresses (01..F7) and public display names.
# VITE_MODBUS_DEVICES_JSON='{"electricity":[{"id":"01","name":"示例电表"}]}'
